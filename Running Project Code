import java.io.*;
import java.nio.file.*;
import java.util.*;

/**
 * Online Food Ordering System - DSA Project
 * Compile: javac Main.java
 * Run:     java Main
 */
class FoodItem {
    private final String id, name;
    private final int price;
    FoodItem(String id, String name, int price) {
        this.id = id; this.name = name; this.price = price;
    }
    String getId() { return id; }
    String getName() { return name; }
    int getPrice() { return price; }
}

class CartItem {
    private final FoodItem item;
    private final int quantity;
    CartItem(FoodItem item, int quantity) {
        this.item = item; this.quantity = quantity;
    }
    FoodItem getItem() { return item; }
    int getQuantity() { return quantity; }
    int getSubtotal() { return item.getPrice() * quantity; }
}

class Order {
    private final String id, customer;
    private final ArrayList<CartItem> items;
    private final int total;
    private boolean prepared;

    Order(String id, String customer, ArrayList<CartItem> items, boolean prepared) {
        this.id = id; this.customer = customer;
        this.items = new ArrayList<>(items);
        this.prepared = prepared;
        int sum = 0;
        for (CartItem item : items) sum += item.getSubtotal();
        this.total = sum;
    }
    String getId() { return id; }
    String getCustomer() { return customer; }
    ArrayList<CartItem> getItems() { return new ArrayList<>(items); }
    int getTotal() { return total; }
    boolean isPrepared() { return prepared; }
    void markPrepared() { prepared = true; }
    String summary() {
        StringBuilder s = new StringBuilder(customer + " | ");
        for (int i = 0; i < items.size(); i++) {
            CartItem c = items.get(i);
            if (i > 0) s.append(", ");
            s.append(c.getItem().getName()).append(" x").append(c.getQuantity());
        }
        return s + " | Total: " + total;
    }
}

public class Main {
    private static final String MENU_FILE = "menu.txt";
    private static final String ORDERS_FILE = "orders.txt";
    private final ArrayList<FoodItem> menu = new ArrayList<>();
    private final HashMap<String, Integer> prices = new HashMap<>();
    private final HashMap<String, FoodItem> itemsById = new HashMap<>();
    private final Queue<Order> pendingOrders = new LinkedList<>();
    private final Stack<Order> recentOrders = new Stack<>();
    private final ArrayList<Order> orderHistory = new ArrayList<>();
    private int nextOrderNumber = 101;

    private void loadMenu() {
        Path path = Paths.get(MENU_FILE);
        try {
            if (!Files.exists(path)) {
                Files.write(path, Arrays.asList(
                        "M101,Veg Burger,120",
                        "M102,Paneer Wrap,150",
                        "M103,Cold Coffee,90"));
            }
            for (String line : Files.readAllLines(path)) {
                if (line.trim().isEmpty()) continue;
                String[] p = line.split(",", 3);
                if (p.length != 3) continue;
                try {
                    FoodItem f = new FoodItem(p[0].trim(), p[1].trim(),
                            Integer.parseInt(p[2].trim()));
                    if (f.getPrice() <= 0) continue;
                    menu.add(f);
                    prices.put(f.getId(), f.getPrice());
                    itemsById.put(f.getId(), f);
                } catch (NumberFormatException ignored) { }
            }
        } catch (IOException e) {
            System.out.println("Could not load menu.txt: " + e.getMessage());
        }
    }

    private void loadOrders() {
        Path path = Paths.get(ORDERS_FILE);
        if (!Files.exists(path)) return;
        try {
            for (String line : Files.readAllLines(path)) {
                if (line.trim().isEmpty()) continue;
                String[] p = line.split("\\|", -1);
                if (p.length != 4) continue;
                String orderId = p[0], customer = p[1];
                boolean prepared = "PREPARED".equalsIgnoreCase(p[2]);
                ArrayList<CartItem> cart = new ArrayList<>();
                if (!p[3].isEmpty()) {
                    for (String entry : p[3].split(";")) {
                        String[] pair = entry.split(":", 2);
                        if (pair.length != 2) continue;
                        FoodItem food = itemsById.get(pair[0]);
                        try {
                            int qty = Integer.parseInt(pair[1]);
                            if (food != null && qty > 0) cart.add(new CartItem(food, qty));
                        } catch (NumberFormatException ignored) { }
                    }
                }
                if (cart.isEmpty()) continue;
                Order order = new Order(orderId, customer, cart, prepared);
                orderHistory.add(order);
                recentOrders.push(order);
                if (!prepared) pendingOrders.offer(order);
                try {
                    int number = Integer.parseInt(orderId.substring(1));
                    nextOrderNumber = Math.max(nextOrderNumber, number + 1);
                } catch (RuntimeException ignored) { }
            }
        } catch (IOException e) {
            System.out.println("Could not load orders.txt: " + e.getMessage());
        }
    }

    private void saveOrders() {
        ArrayList<String> lines = new ArrayList<>();
        for (Order order : orderHistory) {
            StringBuilder line = new StringBuilder();
            line.append(order.getId()).append("|").append(clean(order.getCustomer()))
                    .append("|").append(order.isPrepared() ? "PREPARED" : "PENDING").append("|");
            ArrayList<CartItem> cart = order.getItems();
            for (int i = 0; i < cart.size(); i++) {
                if (i > 0) line.append(";");
                line.append(cart.get(i).getItem().getId()).append(":")
                        .append(cart.get(i).getQuantity());
            }
            lines.add(line.toString());
        }
        try {
            Files.write(Paths.get(ORDERS_FILE), lines);
            System.out.println("Order history saved to orders.txt. Thank you!");
        } catch (IOException e) {
            System.out.println("Could not save orders.txt: " + e.getMessage());
        }
    }

    private String clean(String s) { return s.replace("|", " ").replace("\n", " ").trim(); }

    private void displayMenu() {
        System.out.println("\n--- FOOD MENU ---");
        for (FoodItem f : menu)
            System.out.println(f.getId() + " | " + f.getName() + " | Rs. " + f.getPrice());
    }

    private void placeOrder(Scanner sc) {
        System.out.print("Enter customer name: ");
        String customer = sc.nextLine().trim();
        if (customer.isEmpty()) {
            System.out.println("Customer name cannot be empty.");
            return;
        }
        ArrayList<CartItem> cart = new ArrayList<>();
        Stack<CartItem> cartStack = new Stack<>();
        while (true) {
            System.out.print("Enter item ID: ");
            String id = sc.nextLine().trim().toUpperCase();
            if (!prices.containsKey(id)) {
                System.out.println("Item " + id + " not available.");
                return;
            }
            int quantity = readPositiveInt(sc, "Enter quantity: ",
                    "Quantity must be a positive whole number.");
            CartItem selected = new CartItem(itemsById.get(id), quantity);
            cart.add(selected);
            cartStack.push(selected);
            System.out.println("Added: " + selected.getItem().getName() + " x" + quantity);
            System.out.println("1. Add another item");
            System.out.println("2. Remove last added item");
            System.out.println("3. Confirm order");
            int option = readMenuInt(sc, "Enter option: ", 1, 3);
            if (option == 2) {
                CartItem removed = cartStack.pop();
                cart.remove(removed);
                System.out.println("Removed: " + removed.getItem().getName() + " x" + removed.getQuantity());
                if (cart.isEmpty()) {
                    System.out.println("Cart is empty. Order cancelled.");
                    return;
                }
            } else if (option == 3) {
                Order order = new Order("O" + nextOrderNumber++, customer, cart, false);
                orderHistory.add(order);
                pendingOrders.offer(order);
                recentOrders.push(order);
                System.out.println("Order " + order.getId() + " placed. " + order.summary());
                return;
            }
        }
    }

    private int readPositiveInt(Scanner sc, String prompt, String error) {
        while (true) {
            System.out.print(prompt);
            String value = sc.nextLine().trim();
            try {
                int n = Integer.parseInt(value);
                if (n > 0) return n;
            } catch (NumberFormatException ignored) { }
            System.out.println(error);
        }
    }

    private int readMenuInt(Scanner sc, String prompt, int min, int max) {
        while (true) {
            System.out.print(prompt);
            String value = sc.nextLine().trim();
            try {
                int n = Integer.parseInt(value);
                if (n >= min && n <= max) return n;
            } catch (NumberFormatException ignored) {
                System.out.println("Please enter a valid number.");
                continue;
            }
            System.out.println("Invalid choice. Please enter " + min + "-" + max + ".");
        }
    }

    private void processNextOrder() {
        Order order = pendingOrders.poll();
        if (order == null) {
            System.out.println("No pending orders.");
        } else {
            order.markPrepared();
            System.out.println("Order " + order.getId() + " prepared.");
        }
    }

    private void viewPendingOrders() {
        if (pendingOrders.isEmpty()) {
            System.out.println("No pending orders.");
            return;
        }
        int i = 1;
        for (Order order : pendingOrders)
            System.out.println(i++ + ". " + order.getId() + " | " + order.getCustomer());
    }

    private void sortMenuByPrice() {
        menu.sort(Comparator.comparingInt(f -> prices.get(f.getId())));
        for (FoodItem f : menu)
            System.out.println(f.getId() + " | " + prices.get(f.getId()));
    }

    private void viewRecentOrder() {
        if (recentOrders.empty()) System.out.println("No recent orders.");
        else {
            Order order = recentOrders.peek();
            System.out.println(order.getId() + " | " + order.summary()
                    + " | " + (order.isPrepared() ? "PREPARED" : "PENDING"));
        }
    }

    private void run() {
        loadMenu();
        loadOrders();
        Scanner sc = new Scanner(System.in);
        while (true) {
            System.out.println("\n==== ONLINE FOOD ORDERING SYSTEM ====");
            System.out.println("1. View Menu");
            System.out.println("2. Place Order");
            System.out.println("3. Process Next Order");
            System.out.println("4. View Pending Orders");
            System.out.println("5. Sort Menu by Price");
            System.out.println("6. View Most Recent Order");
            System.out.println("7. Exit");
            int choice = readMenuInt(sc, "Enter your choice: ", 1, 7);
            switch (choice) {
                case 1: displayMenu(); break;
                case 2: placeOrder(sc); break;
                case 3: processNextOrder(); break;
                case 4: viewPendingOrders(); break;
                case 5: sortMenuByPrice(); break;
                case 6: viewRecentOrder(); break;
                case 7: saveOrders(); sc.close(); return;
                default: break;
            }
        }
    }

    public static void main(String[] args) {
        new Main().run();
    }
}
